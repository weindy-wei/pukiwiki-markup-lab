[Unit]
Description=FilmWiki isolated versioned editor, synthetic working copy only
After=network.target
ConditionPathExists=/home/administrator/filmwiki-data/editing/synthetic-step28-editor.sqlite

[Service]
Type=simple
User=administrator
Group=administrator
WorkingDirectory=/home/administrator/filmwiki-data
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /home/administrator/filmwiki-data/services/server_v4.py --data-root /home/administrator/filmwiki-data --db /home/administrator/filmwiki-data/editing/synthetic-step28-editor.sqlite --local-no-token --project-id demo-editor --port 8094
Restart=on-failure
RestartSec=3s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ReadWritePaths=/home/administrator/filmwiki-data/editing
RestrictAddressFamilies=AF_UNIX AF_INET

[Install]
WantedBy=multi-user.target
